<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Schiller_DisV_16.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Schiller_DisV_16"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Colorbox">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <!-- ja se v tom uz nevyznam.......................... -->

    <Grid>
        <!-- Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions -->

        <!-- Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock Text="Schiller_DisV_16"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>
        </Grid se na to muzu vysrat -->

        <!-- bez toho titlebar zabiral celou vysku -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- tak treba ted to pujde -->
        <!-- takze. na tohle jsem musel manualne upravit csproj jo 
             proc proste to neni defaultni titlebar ve winui, misto old win32 titlebaru...
             BLOOOOOOOOOAT -->
        <TitleBar x:Name="AppTitleBar" 
                  Title="Colorbox"
                  Grid.Row="0"
                  Background="{ThemeResource SolidBackgroundFillColorBase}">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/StoreLogo.png" ShowAsMonochrome="False" />
            </TitleBar.IconSource>
        </TitleBar>
        
        <Grid Grid.Row="1" Padding="40,40,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- prej to tu ma byt
                     pokud chapu spravne tak to je aby byly ty pulky even -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- slidery nalevo -->
                <StackPanel VerticalAlignment="Top" 
                                Grid.Column="0"
                                Spacing="16" 
                                Padding="20,0,20,10">

                    <TextBlock Text="Color palette"
                                   Style="{ThemeResource TitleTextBlockStyle}"/>

                    <Slider x:Name="R"
                                Header="R"
                                Minimum="0"
                                Maximum="255"
                                Value="0"
                                ValueChanged="R_ValueChanged"/>

                    <Slider x:Name="G"
                                Header="G"
                                Minimum="0"
                                Maximum="255"
                                Value="0"
                                ValueChanged="G_ValueChanged"/>

                    <Slider x:Name="B"
                                Header="B"
                                Minimum="0"
                                Maximum="255"
                                Value="0"
                                ValueChanged="B_ValueChanged"/>
                </StackPanel>

                <!-- prev na pravo -->
                <StackPanel Grid.Column="1" Padding="20,0,20,10" HorizontalAlignment="Center">
                    <TextBlock Text="Preview"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,16"/>
                    
                    <Grid CornerRadius="12" Height="Auto">
                        <Canvas Height="180"
                                Width="200"
                                Background="#000000"
                                x:Name="Canvas"
                                Margin="0,0,0,0"/>
                    </Grid>
                    
                    <!-- mozna trosku narocnejsi na postaveni nez forms, ale vysledek je fajn -->
                    <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    Spacing="16"
                                Margin="0,16,0,0">
                        <TextBlock Text="0, 0, 0" 
                                       VerticalAlignment="Center"
                                       x:Name="ColorText"/>
                        <Button Content="Save" 
                                    Click="Button_Click"
                                    Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Rectangle Height="1"
               HorizontalAlignment="Stretch"
               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/ -->
            
            <Grid Grid.Row="1" Padding="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- nestedddd -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Saved Colors"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="0 saved"
                                   x:Name="SavedColorsCount"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Opacity="0.6"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                         Content="Save to file"
                         Click="Button_Click_1"
                         VerticalAlignment="Center"/>
                </Grid>

                <!-- mi zacina pripadat jako overengineering 
                     pripadam si jako kdyz XBOX delal kinect 
                
                     The Most Over-Engineered Controller od Arctic Gaming
                     https://www.youtube.com/watch?v=yeizrRzLR1Q 
                     
                     mala kulturni vlozka :p -->
                <Grid Grid.Row="1">
                    <ListView Grid.Row="1"
                       x:Name="ColorHistory"
                       HorizontalAlignment="Stretch"
                       AllowDrop="True"
                       DragOver="ColorHistory_DragOver"
                       Drop="ColorHistory_Drop">

                        <!-- prijde mi to lepsi nez forms tbh -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" Background="Transparent">

                                    <!-- CUSTOM RIGHT CLICK MENU OMFG -->
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Delete" 
                                                     Click="MenuFlyoutItem_Click"
                                                     CommandParameter="{Binding}"/>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <StackPanel Orientation="Horizontal"
                                         Spacing="15"
                                         Padding="5">
                                        <!-- bindings jsou cool -->
                                        <Border Width="24" 
                                         Height="24"
                                         Background="{Binding ColorBrush}"/>

                                        <TextBlock Text="{Binding ColorText}"
                                            VerticalAlignment="Center"
                                            Style="{ThemeResource BodyTextBlockStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <TextBlock x:Name="EmptyColorsText"
                               Text="No saved colors. Drag a .txt on me!"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Opacity="0.6"
                               IsHitTestVisible="False"/>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
